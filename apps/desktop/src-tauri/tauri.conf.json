{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssetMesh",
  "version": "0.3.0",
  "identifier": "com.assetmesh.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AssetMesh",
        "width": 1280,
        "height": 840,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
